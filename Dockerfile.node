FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/lodestone-node ./cmd/lodestone-node

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/lodestone-node /usr/local/bin/lodestone-node
ENV LODESTONE_NODE_LISTEN=0.0.0.0:8480
EXPOSE 8480
ENTRYPOINT ["lodestone-node"]
