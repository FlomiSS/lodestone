# Zugang des ersten Administrators (wird nur beim allerersten Start angelegt)
LODESTONE_ADMIN_USER=admin
LODESTONE_ADMIN_PASSWORD=
# Gemeinsames Geheimnis zwischen Panel und Node, mindestens 24 Zeichen:  openssl rand -hex 32
LODESTONE_NODE_TOKEN=
# Adresse, unter der Spieler die Maschine erreichen (für Beitritts-Adresse und Voicechat)
LODESTONE_PUBLIC_HOST=
# Port der Weboberfläche auf der Maschine
LODESTONE_PANEL_PORT=8480
# Ordner auf der Maschine für alle Serverdaten (muss existieren, Besitzer 1000:1000)
LODESTONE_DATA=/srv/lodestone
# Bereich, aus dem Server-Ports vergeben werden
LODESTONE_PORT_RANGE=25565-25999
# Gruppe des Docker-Sockets:  stat -c %g /var/run/docker.sock
DOCKER_GID=999
# Hinter HTTPS-Proxy auf true setzen
LODESTONE_SECURE_COOKIES=false
LODESTONE_TRUST_PROXY=false
