# Baut Oberfläche und Panel komplett im Container (für alle, die Lodestone selbst bauen wollen).
FROM node:25-alpine AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npx next build

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN rm -rf internal/panel/webui/dist
COPY --from=web /src/web/out internal/panel/webui/dist
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/lodestone-panel ./cmd/lodestone-panel

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 1000 lodestone && mkdir /data && chown lodestone /data
COPY --from=build /out/lodestone-panel /usr/local/bin/lodestone-panel
USER lodestone
ENV LODESTONE_DATA_DIR=/data LODESTONE_LISTEN=:8480
VOLUME /data
EXPOSE 8480
ENTRYPOINT ["lodestone-panel"]
