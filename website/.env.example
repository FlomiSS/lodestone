# ==============================================================================
# Lodestone Konfiguration (.env)
# https://henny263462.github.io/lodestone/
# ==============================================================================

# Zugang des ersten Administrators (wird nur beim allerersten Start angelegt)
LODESTONE_ADMIN_USER=admin
LODESTONE_ADMIN_PASSWORD=dein-sicheres-passwort

# Gemeinsames Geheimnis zwischen Panel und Node (mind. 24 Zeichen)
# Erzeugen mit: openssl rand -hex 32
LODESTONE_NODE_TOKEN=bitte-ein-langes-zufaelliges-geheimnis-eintragen

# Öffentliche IP oder Domain deines Servers (für Spieler-Beitrittsadresse)
LODESTONE_PUBLIC_HOST=

# Port der Weboberfläche (Standard: 8480 -> http://deine-ip:8480)
LODESTONE_PANEL_PORT=8480

# Verzeichnis für Minecraft-Serverdaten (muss existieren, chown 1000:1000)
LODESTONE_DATA=/srv/lodestone

# Portbereich für Minecraft-Server
LODESTONE_PORT_RANGE=25565-25999

# Gruppe des Docker-Sockets auf dem Host: stat -c %g /var/run/docker.sock
DOCKER_GID=999

# Falls Lodestone hinter einem Reverse-Proxy (Nginx, Traefik, Caddy) mit SSL läuft
LODESTONE_SECURE_COOKIES=false
LODESTONE_TRUST_PROXY=false
